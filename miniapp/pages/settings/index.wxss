.settings-page { padding: 31rpx 26rpx 55rpx; }
.settings-page .section-title { margin: 8rpx 0 22rpx; }
.settings-card { margin: 0 0 18rpx; }
.card-title { margin-bottom: 9rpx; font-size: 31rpx; font-weight: 700; }
.settings-card .muted { font-size: 24rpx; }
input { box-sizing: border-box; width: 100%; height: 82rpx; padding: 0 18rpx; border: 3rpx solid #E9D8C8; border-radius: 20rpx; margin: 20rpx 0 0; background: #fff; font-size: 25rpx; }
button { margin-top: 20rpx; }
.account-actions { margin-top: 30rpx; }
.invitation-result { margin-top: 24rpx; padding: 24rpx; border: 3rpx solid #F3C785; border-radius: 24rpx; background: #FFF1DF; }
.invitation-code { font-size: 33rpx; font-weight: 800; color: #A93420; overflow-wrap: anywhere; }
.invitation-result .muted { margin-top: 12rpx; font-size: 23rpx; }
