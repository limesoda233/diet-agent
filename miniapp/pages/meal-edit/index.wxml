<view class="edit-page">
  <view class="eyebrow">给小狗多一点线索</view>
  <view class="section-title">{{id ? '编辑餐食' : '记录一道喜欢的餐食'}}</view>
  <view class="muted edit-lead">输入名字后可让小狗推荐标签，也可以自己点选；确认后再保存到个人餐食库。</view>
  <view class="card edit-card">
    <view class="field"><view class="field-label">餐食名称</view><input value="{{name}}" bindinput="onName" maxlength="128" placeholder="例如：番茄鸡蛋面" /></view>
    <view class="field"><view class="field-label">补充描述（选填）</view><input value="{{description}}" bindinput="onDescription" placeholder="例如：早上吃，不加辣" /></view>
    <button class="button-soft analyze" disabled="{{generating || saving}}" loading="{{generating}}" bindtap="generate">小狗帮我选标签</button>
    <view class="muted edit-tip">点选中的标签可取消，点未选中的标签可添加。</view>
    <view wx:for="{{groups}}" wx:key="field" class="tag-group">
      <view class="field-label">{{item.label}}{{item.field === 'mealTime' ? '（必选）' : ''}}</view>
      <view class="tag-list">
        <button wx:for="{{item.choices}}" wx:for-item="choice" wx:key="value"
          class="tag {{choice.selected ? 'selected' : ''}}" data-field="{{item.field}}" data-value="{{choice.value}}" bindtap="toggleTag">{{choice.value}}</button>
      </view>
    </view>
    <view wx:if="{{nutritionGroups.length}}" class="nutrition-section">
      <view class="field-label">这顿怎么搭配？</view>
      <view class="muted edit-tip">按平时吃的一份来选，热量只是粗估范围。</view>
      <view wx:for="{{nutritionGroups}}" wx:key="key" class="tag-group">
        <view class="field-label">{{item.label}}</view>
        <view class="tag-list">
          <button wx:for="{{item.choices}}" wx:for-item="choice" wx:key="value"
            class="tag {{choice.selected ? 'selected' : ''}}" data-key="{{item.key}}" data-value="{{choice.value}}" bindtap="chooseNutrition">{{choice.label}}</button>
        </view>
      </view>
      <view wx:if="{{nutritionDraft.estimate}}" class="nutrition-estimate">
        <view>每份约 {{nutritionDraft.estimate.kcalLow}}–{{nutritionDraft.estimate.kcalHigh}} 千卡</view>
        <view class="muted">碳水 {{nutritionDraft.estimate.carbsLow}}–{{nutritionDraft.estimate.carbsHigh}} g · 蛋白质 {{nutritionDraft.estimate.proteinLow}}–{{nutritionDraft.estimate.proteinHigh}} g</view>
        <view class="muted">仅供搭配参考，实际分量和做法会改变热量。</view>
      </view>
    </view>
    <view wx:if="{{savedVariants.length}}" class="nutrition-section">
      <view class="field-label">已保存的搭配版本</view>
      <view wx:for="{{savedVariants}}" wx:key="id" class="saved-variant">
        <view>{{item.label}}</view>
        <view class="muted">约 {{item.estimate.kcalLow}}–{{item.estimate.kcalHigh}} 千卡/份</view>
        <view class="variant-actions"><button class="button-soft" data-id="{{item.id}}" bindtap="editVariant">按此版本修改</button><button class="button-soft" data-id="{{item.id}}" bindtap="removeVariant">删除版本</button></view>
      </view>
    </view>
    <view wx:if="{{error}}" class="danger edit-error">{{error}}</view>
    <button loading="{{saving}}" disabled="{{generating || saving}}" bindtap="save">{{id ? '保存修改' : '保存到我的餐食库'}}</button>
  </view>
</view>
