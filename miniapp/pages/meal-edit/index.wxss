.edit-page { padding: 32rpx 26rpx 50rpx; }
.edit-page .section-title { margin: 8rpx 0 10rpx; }
.edit-lead { font-size: 24rpx; }
.edit-card { margin: 26rpx 0 0; }
.field { margin-bottom: 24rpx; }
.field-label { margin-bottom: 9rpx; font-size: 25rpx; font-weight: 700; }
.field-label text { margin-left: 8rpx; color: #7B695F; font-size: 21rpx; font-weight: 400; }
input { box-sizing: border-box; width: 100%; height: 78rpx; padding: 0 18rpx; border: 3rpx solid #E9D8C8; border-radius: 20rpx; background: #fff; font-size: 25rpx; }
.edit-card button { margin-top: 10rpx; min-height: 88rpx; }
.edit-card .analyze { width: 100%; margin: 5rpx 0 20rpx; }
.edit-tip { font-size: 23rpx; margin: 7rpx 0 26rpx; }
.tag-group { margin: 25rpx 0; }
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.edit-card .tag { width: auto; min-height: 66rpx; margin: 0; padding: 7rpx 20rpx; border: 3rpx solid #e9d8c8; background: #fff; color: #725447; box-shadow: 0 4rpx 0 #e9d8c8; font-size: 23rpx; }
.edit-card .tag.selected { border-color: #d94b2b; background: #fff1df; color: #a93420; box-shadow: 0 4rpx 0 #f3c785; }
.edit-error { margin: 22rpx 0; font-size: 24rpx; }
