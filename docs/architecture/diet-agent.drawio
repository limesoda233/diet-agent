          <mxGeometry x="1370" y="505" width="200" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="d-weighted" value="&lt;b&gt;加权综合分&lt;/b&gt;&lt;br&gt;按实际存在的指标权重归一&lt;br&gt;缺失指标不按 0 分处理" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="515" width="210" height="155" as="geometry"/>
        </mxCell>
