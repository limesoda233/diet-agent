        <mxCell id="ae-agent-prompts" value="加载系统提示词" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;fontSize=10;" edge="1" parent="1" source="a-agent-builder" target="a-data-prompts">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ae-service-mapper" value="CRUD / 查询" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;fontSize=10;" edge="1" parent="1" source="a-core-meal-crud" target="a-data-mybatis">
          <mxGeometry relative="1" as="geometry"/>
