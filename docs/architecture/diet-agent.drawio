        <mxCell id="fe-ask-end" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="1" source="f-ask" target="f-end"><mxGeometry relative="1" as="geometry"/></mxCell>
