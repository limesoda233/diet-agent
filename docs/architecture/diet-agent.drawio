          <mxGeometry x="55" y="720" width="260" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="d-feedback" value="&lt;b&gt;recommend_feedback&lt;/b&gt;&lt;br&gt;&lt;div align=&quot;left&quot;&gt;🔑 id bigint&lt;br&gt;user_id · session_id&lt;br&gt;item_id&lt;br&gt;action · rating · reason&lt;br&gt;created_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="750" width="230" height="170" as="geometry"/>
