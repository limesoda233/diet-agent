  <diagram id="data-evaluation" name="03-数据模型与评估闭环">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d-title" value="数据模型与 Trace 评估闭环" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="600" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="d-db-label" value="MySQL 逻辑数据模型" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="300" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="d-eval-label" value="反馈、标注与离线评估闭环" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="850" y="80" width="350" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="d-divider" value="" style="shape=line;html=1;strokeColor=#BDBDBD;dashed=1;direction=south;" vertex="1" parent="1">
          <mxGeometry x="790" y="90" width="10" height="850" as="geometry"/>
        </mxCell>

        <mxCell id="d-sessions" value="&lt;b&gt;diet_sessions&lt;/b&gt;&lt;br&gt;&lt;div align=&quot;left&quot;&gt;🔑 id varchar(64)&lt;br&gt;user_id bigint&lt;br&gt;phase varchar(64)&lt;br&gt;slots json&lt;br&gt;last_recommendations json&lt;br&gt;created_at / updated_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="220" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="d-messages" value="&lt;b&gt;diet_messages&lt;/b&gt;&lt;br&gt;&lt;div align=&quot;left&quot;&gt;🔑 id bigint&lt;br&gt;session_id varchar(64)&lt;br&gt;role varchar(32)&lt;br&gt;content text&lt;br&gt;intent varchar(64)&lt;br&gt;agent_trace_id varchar(128)&lt;br&gt;created_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="135" width="240" height="205" as="geometry"/>
        </mxCell>
        <mxCell id="d-trace" value="&lt;b&gt;diet_request_trace&lt;/b&gt;&lt;br&gt;&lt;div align=&quot;left&quot;&gt;🔑 id · trace_id (UK)&lt;br&gt;session_id · user_id&lt;br&gt;status · event_count · duration_ms&lt;br&gt;error_message · trace_json&lt;br&gt;expected_intent · expected_slots&lt;br&gt;expected_clarify_action&lt;br&gt;labeled_by / at · label_note&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="420" width="270" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="d-meal" value="&lt;b&gt;meal_item&lt;/b&gt;&lt;br&gt;&lt;div align=&quot;left&quot;&gt;🔑 id bigint&lt;br&gt;source_type (PUBLIC/PERSONAL)&lt;br&gt;owner_user_id · name&lt;br&gt;meal_time · mood · scene (json)&lt;br&gt;health_goal · cuisine (json)&lt;br&gt;taste · convenience (json)&lt;br&gt;created_at / updated_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;spacing=10;" vertex="1" parent="1">
