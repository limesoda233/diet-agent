        <mxCell id="ae-state-mapper" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="1" source="a-core-state" target="a-data-mybatis">
