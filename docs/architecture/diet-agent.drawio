        <mxCell id="de-session-message" value="1 : N 会话消息" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;strokeColor=#D79B00;fontSize=10;" edge="1" parent="1" source="d-sessions" target="d-messages"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de-session-trace" value="1 : N 请求 Trace" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;strokeColor=#9673A6;dashed=1;fontSize=10;" edge="1" parent="1" source="d-sessions" target="d-trace"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de-message-trace" value="agent_trace_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#9673A6;dashed=1;fontSize=10;" edge="1" parent="1" source="d-messages" target="d-trace"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de-session-feedback" value="1 : N 用户反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;strokeColor=#6C8EBF;dashed=1;fontSize=10;" edge="1" parent="1" source="d-sessions" target="d-feedback"><mxGeometry relative="1" as="geometry"/></mxCell>
