        <mxCell id="fe-empty-save" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="1" source="f-empty-result" target="f-save"><mxGeometry relative="1" as="geometry"/></mxCell>
