        <mxCell id="d-eval-service" value="&lt;b&gt;EvaluationService&lt;/b&gt;&lt;br&gt;按时间范围读取 Trace&lt;br&gt;关联同 Session 反馈&lt;br&gt;解析 trace_json 快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
