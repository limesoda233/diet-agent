  </diagram>

  <diagram id="chat-flow" name="02-核心对话流程">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="f-title" value="核心对话状态机与推荐链路" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="600" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="f-subtitle" value="入口：POST /api/v1/diet/chat　　核心：DietOrchestratorService.dietChat()" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="450" y="60" width="700" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="f-start" value="用户提交&lt;br&gt;message + sourceMode&lt;br&gt;可选 sessionId" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="120" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="f-validate" value="校验请求&lt;br&gt;生成 traceId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="145" width="140" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="f-load" value="加载或创建 SessionState&lt;br&gt;phase / slots / sourceMode&lt;br&gt;lastRecommendations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="135" width="175" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="f-lock" value="打开 TraceScope&lt;br&gt;获取 session 级锁&lt;br&gt;同会话串行执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="625" y="135" width="170" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="f-record" value="保存用户消息&lt;br&gt;diet_messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="845" y="145" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="f-personal" value="PERSONAL 且&lt;br&gt;个人餐食库为空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1045" y="125" width="170" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="f-empty-reply" value="返回“先录入个人餐食”&lt;br&gt;保存状态和助手消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="135" width="190" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="f-intent" value="IntentAgent&lt;br&gt;用户输入 + 已知槽位&lt;br&gt;+ 最近 3 条对话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="330" width="180" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="f-revise" value="IntentReviseService&lt;br&gt;结合历史 phase / slots&lt;br&gt;/ lastRecommendations 修正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="665" y="325" width="185" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="f-route" value="按最终 Intent 路由" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="315" width="170" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="f-rec" value="MEAL_RECOMMENDATION&lt;br&gt;/ CLARIFY_NEEDED&lt;br&gt;合并历史与本轮槽位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="95" y="520" width="190" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f-adjust" value="MEAL_ADJUST&lt;br&gt;合并槽位&lt;br&gt;排除 lastRecommendations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="520" width="190" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f-plan" value="MEAL_PLAN&lt;br&gt;合并槽位&lt;br&gt;phase = PLAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="565" y="520" width="175" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f-risk" value="HEALTH_RISK&lt;br&gt;返回保守健康提示&lt;br&gt;不走推荐链路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="785" y="520" width="175" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f-other" value="OTHER&lt;br&gt;返回固定饮食引导&lt;br&gt;不调用 LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1005" y="520" width="175" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="f-clarify" value="ClarifyRule + ClarifyAgent&lt;br&gt;槽位是否足够？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="95" y="685" width="190" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="f-ask" value="phase = CLARIFY&lt;br&gt;保存追问与 missingSlots&lt;br&gt;等待用户下一轮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="885" width="190" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f-search" value="MealSearchService&lt;br&gt;按 sourceMode + userId&lt;br&gt;+ 7 维 slots 从 DB 召回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="700" width="190" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="f-rank" value="MealRankService&lt;br&gt;槽位命中打分&lt;br&gt;排除已推荐 ID · Top 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="565" y="700" width="180" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="f-noresult" value="结果为空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="690" width="150" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="f-response-agent" value="RecommendResponseAgent&lt;br&gt;Top 3 + 用户原文 + slots&lt;br&gt;生成理由、口语回复、卡片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="700" width="210" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="f-guard" value="Nutrition Risk Guard&lt;br&gt;检查用户输入 + 最终回复&lt;br&gt;不通过则替换为保守提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1245" y="700" width="210" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="f-empty-result" value="按 PERSONAL / PUBLIC&lt;br&gt;返回不同空结果提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="885" width="170" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="f-save" value="保存最终状态&lt;br&gt;追加 lastRecommendations&lt;br&gt;保存助手消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="885" width="190" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f-end" value="ChatResponse&lt;br&gt;speechText + displayBlocks&lt;br&gt;+ nextAction + traceId" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1340" y="875" width="150" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="f-trace-bar" value="AgentTraceService 横切全流程：REQUEST_RECEIVED → USER_MESSAGE_RECORDED → INTENT_RECOGNIZED / REVISED → ROUTE_SELECTED → SEARCH / RANK / RESPONSE / GUARD → REQUEST_FINISHED；异常记录 REQUEST_FAILED，TraceScope 关闭时写入 diet_request_trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673A6;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="1025" width="1100" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="fe-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;" edge="1" parent="1" source="f-start" target="f-validate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="1" source="f-validate" target="f-load"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="1" source="f-load" target="f-lock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="1" source="f-lock" target="f-record"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="1" source="f-record" target="f-personal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=11;" edge="1" parent="1" source="f-personal" target="f-empty-reply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-7" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;fontSize=11;" edge="1" parent="1" source="f-personal" target="f-intent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="1" source="f-intent" target="f-revise"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="1" source="f-revise" target="f-route"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-route-rec" value="推荐 / 澄清" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;fontSize=10;" edge="1" parent="1" source="f-route" target="f-rec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-route-adjust" value="调整" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;fontSize=10;" edge="1" parent="1" source="f-route" target="f-adjust"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-route-plan" value="规划" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;fontSize=10;" edge="1" parent="1" source="f-route" target="f-plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-route-risk" value="健康风险" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="f-route" target="f-risk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-route-other" value="其他" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="f-route" target="f-other"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-rec-clarify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="1" source="f-rec" target="f-clarify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-clarify-ask" value="ASK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;fontSize=11;" edge="1" parent="1" source="f-clarify" target="f-ask"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-clarify-search" value="READY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;fontSize=11;" edge="1" parent="1" source="f-clarify" target="f-search"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-adjust-search" value="共用推荐流水线" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;fontSize=10;" edge="1" parent="1" source="f-adjust" target="f-search"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-plan-search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;" edge="1" parent="1" source="f-plan" target="f-search"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-search-rank" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="1" source="f-search" target="f-rank"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-rank-noresult" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="1" source="f-rank" target="f-noresult"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-noresult-empty" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="f-noresult" target="f-empty-result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-noresult-agent" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1" source="f-noresult" target="f-response-agent"><mxGeometry relative="1" as="geometry"/></mxCell>
