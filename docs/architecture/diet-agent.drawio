        <mxCell id="d-eval-trace" value="&lt;b&gt;请求 Trace&lt;/b&gt;&lt;br&gt;状态机事件 · Agent I/O&lt;br&gt;token · latency · fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
