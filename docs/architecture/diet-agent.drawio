        <mxCell id="fe-other-save" value="纯文本完成分支" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="f-other" target="f-save"><mxGeometry relative="1" as="geometry"/></mxCell>
